{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emperorstats.com/data/emperors.schema.json",
  "title": "中国皇帝統計データセット（emperorstats.com）",
  "description": "始皇帝から溥儀まで、実際に「皇帝」を名乗った365人の在位・死因・即位経路など全12項目を正史原典から個別調査したデータセット。人間可読な定義は data/schema/EMPERORS_SCHEMA.md・DEATH_CAUSE_SCHEMA.md・ADDITIONAL_SCHEMA.md・INCLUSION_CRITERIA.md を参照。",
  "type": "object",
  "required": ["meta", "emperors"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "emperors": {
      "type": "array",
      "description": "皇帝レコードの配列。収録基準は INCLUSION_CRITERIA.md（皇帝号を実際に称した人物）。",
      "items": { "$ref": "#/$defs/emperor" }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "description": "データセット全体のメタ情報。調査進捗の管理用フィールド（*CompletedBlocks・status）を含む。",
      "required": ["title", "count", "schemaVersion", "generatedAt"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "count": {
          "type": "integer",
          "description": "収録皇帝数。emperors 配列の長さと一致する。"
        },
        "catalogs": { "$ref": "#/$defs/catalogs" },
        "schemaVersion": {
          "type": "string",
          "description": "データ構造の版（セマンティックバージョン）。フィールドの追加・改名時に上がる。データ内容の版とは別軸。"
        },
        "generatedAt": {
          "type": "string",
          "description": "このファイルを最後に更新した日付（YYYY-MM-DD）。",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source": {
          "type": "object",
          "description": "情報源の全体方針。primary は正史原典（個々の判定根拠は各レコードの source フィールド）、inclusionListSeed は収録候補リストの初期洗い出しに使った参照でデータ値の典拠ではない。",
          "properties": {
            "primary": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "note": { "type": "string" }
              }
            },
            "inclusionListSeed": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "page": { "type": "string" },
                "url": { "type": "string" },
                "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "note": { "type": "string" }
              }
            },
            "supplementary": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "license": {
          "type": "object",
          "description": "二重ライセンス構成。data＝データセットと調査メモ文章（CC BY 4.0）、code＝リポジトリのコード（MIT）。",
          "required": ["data", "code"],
          "properties": {
            "data": { "$ref": "#/$defs/licenseEntry" },
            "code": { "$ref": "#/$defs/licenseEntry" }
          }
        },
        "version": {
          "type": "string",
          "description": "データ内容の版（CalVer: YYYY.MM）。構造の版 schemaVersion とは別軸で、データの訂正・追加で上がる。",
          "pattern": "^\\d{4}\\.\\d{2}$"
        },
        "inclusionCriteria": { "type": ["object", "string", "array"] },
        "reignDaysPolicy": { "type": ["object", "string", "array"] },
        "status": {
          "type": "object",
          "description": "調査フェーズの進捗管理（内部運用フィールド）。",
          "properties": {
            "overall": { "type": "string" },
            "phases": { "type": "object" }
          }
        }
      },
      "patternProperties": {
        "Blocks$": {
          "type": ["array", "object"],
          "description": "調査ブロック単位の記録（内部運用フィールド）。completedBlocks・*CompletedBlocks・reignDurationSourceBlocks が該当。"
        }
      }
    },
    "catalogs": {
      "type": "object",
      "description": "時代（eras）・政権（regimes）・enum の表示ラベル集約カタログ（v3）。レコード側は安定 ID のみを持ち、日本語ラベル・将来の多言語ラベルはここにしか置かない。設計は docs/schema/V3_MIGRATION_PLAN.md。",
      "required": ["eras", "regimes", "enums"],
      "properties": {
        "note": { "type": "string" },
        "eras": {
          "type": "array",
          "description": "時代区分（11 区分）。調査ブロック（researchSection）とは独立した、時代ジャンプ・並び順のための固定カタログ。",
          "items": {
            "type": "object",
            "required": ["id", "label", "sortOrder"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
              "label": { "type": "string" },
              "labelEn": { "type": ["string", "null"] },
              "sortOrder": { "type": "integer" }
            }
          }
        },
        "regimes": {
          "type": "array",
          "description": "政権カタログ。同一国号の別政権を含めて一意になる ID を持つ。startYear/endYear は表示用のヒントで、政権同士の年幅は入れ子・重複しうる（唐と武周など）。",
          "items": {
            "type": "object",
            "required": ["id", "name", "label", "eraId", "category", "sortOrder"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
              "name": { "type": "string", "description": "国号（例:「梁」）。単体では一意でない。" },
              "label": { "type": "string", "description": "一覧・凡例で使う曖昧性のない表示名（例:「梁（蕭梁）」）。" },
              "labelEn": { "type": ["string", "null"] },
              "eraId": { "type": "string" },
              "category": { "type": "string", "description": "政権の性格。catalogs.enums.regimeCategory の ID。" },
              "startYear": { "type": "integer" },
              "endYear": { "type": "integer" },
              "sortOrder": { "type": "integer" },
              "dynastyOrderSurveyed": {
                "type": "boolean",
                "description": "reigns[].dynastyOrder（第N代）をこの政権について個別調査済みか。false の政権では dynastyOrder は全て null で、第N代は未確定（サイト側で在位順から推論しないこと）。"
              }
            }
          }
        },
        "enums": {
          "type": "object",
          "description": "フィールドごとの enum カタログ。キーはフィールド名（accessionCategory・deathCause など）、値は {id,label} の配列。ID はフィールド内で一意（フィールドをまたぐ同名 ID は別物）。",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
                "label": { "type": "string" },
                "labelEn": { "type": ["string", "null"] },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },

    "licenseEntry": {
      "type": "object",
      "required": ["name", "spdx", "scope"],
      "properties": {
        "name": { "type": "string" },
        "spdx": { "type": "string" },
        "url": { "type": "string" },
        "scope": { "type": "string" },
        "attribution": { "type": "string" },
        "fullText": {
          "type": "string",
          "description": "ライセンス全文ファイルのリポジトリ相対パス。"
        }
      }
    },

    "emperor": {
      "type": "object",
      "required": ["id", "name", "dynasty", "reigns", "reignSummary", "flags"],
      "properties": {
        "id": {
          "type": "string",
          "description": "皇帝の一意識別子（slug）。emperorstats.com/emperors/{id} のURLに対応する。",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": { "$ref": "#/$defs/name" },
        "dynasty": { "$ref": "#/$defs/dynasty" },
        "eraId": {
          "type": "string",
          "description": "所属時代。meta.catalogs.eras の ID（regimes[regimeId].eraId の非正規化コピー）。時代ジャンプ・並び順に使う。"
        },
        "regimeId": {
          "type": "string",
          "description": "所属政権。meta.catalogs.regimes の ID。同一国号の別政権も含めて一意。"
        },
        "researchSection": {
          "type": "string",
          "description": "調査ブロック名（旧 dynasty.section）。docs/process/SOURCE_MAPPING.md の索引キーで、表示用の時代区分ではない。"
        },
        "standing": {
          "type": "string",
          "description": "その政権における位置づけ。meta.catalogs.enums.emperorStanding の ID（regular=歴代の皇帝／rival=同一国号内の対立・僭称）。即位の経緯は accessionRoute が担う。",
          "enum": ["regular", "rival"]
        },
        "reigns": {
          "type": "array",
          "description": "在位期間の配列。復位した皇帝は複数要素を持つ（8名）。",
          "minItems": 1,
          "items": { "$ref": "#/$defs/reign" }
        },
        "reignSummary": { "$ref": "#/$defs/reignSummary" },
        "flags": { "$ref": "#/$defs/flags" },
        "sources": { "$ref": "#/$defs/externalSources" },
        "verification": { "$ref": "#/$defs/verification" },
        "deathCause": { "$ref": "#/$defs/deathCause" },
        "accessionRoute": { "$ref": "#/$defs/accessionRoute" },
        "ages": { "$ref": "#/$defs/ages" },
        "eraChangeCount": {
          "description": "改元回数。events[] は改元1件ごとの記録。",
          "$ref": "#/$defs/datedEventCount"
        },
        "amnestyCount": {
          "description": "大赦回数。恩赦のうち原典が「大赦」と明記するものを数える。",
          "$ref": "#/$defs/datedEventCount"
        },
        "empressInstallationCount": {
          "description": "立后（皇后冊立）回数。",
          "$ref": "#/$defs/datedEventCount"
        },
        "crownPrinceDepositionCount": {
          "description": "皇太子廃立回数。",
          "$ref": "#/$defs/datedEventCount"
        },
        "capitalRelocationCount": {
          "description": "遷都回数。events[] は from/to（遷都元・遷都先）を持つ。",
          "$ref": "#/$defs/capitalRelocationCountObject"
        },
        "personalCampaignCount": {
          "description": "親征回数（皇帝自身が軍を率いた対外遠征）。events[] は target（遠征対象）を持つ。",
          "$ref": "#/$defs/campaignCountObject"
        },
        "rebellionSuppressionCount": {
          "description": "反乱鎮圧回数（自政権の支配下で起きた反乱を鎮圧した回数）。",
          "$ref": "#/$defs/rebellionCountObject"
        },
        "rebellionSufferedCount": {
          "description": "被反乱回数（自政権が反乱を起こされた回数）。判定基準は ADDITIONAL_SCHEMA.md 9節。",
          "$ref": "#/$defs/rebellionCountObject"
        }
      }
    },

    "name": {
      "type": "object",
      "description": "各種名称。中国の皇帝は諱・廟号・諡号・通称が併存するため、用途別に保持する。",
      "properties": {
        "personalName": {
          "type": ["string", "null"],
          "description": "諱（本名）。"
        },
        "commonName": {
          "type": "string",
          "minLength": 1,
          "description": "通称（最も一般的な呼称。例:「始皇帝」「聖祖（康熙帝）」）。廟号・諡号を持たない皇帝は諱をそのまま用いる（例:「曹芳」「赫連昌」）。"
        },
        "templeName": {
          "type": ["string", "null"],
          "description": "廟号（例:「太宗」）。廟号を持たない皇帝は null。"
        },
        "posthumousName": {
          "type": ["string", "null"],
          "description": "諡号（例:「文帝」）。"
        },
        "regnalTitle": {
          "type": ["string", "null"],
          "description": "称した君主号（原則「皇帝」。収録基準の根拠となる）。"
        },
        "aliases": {
          "type": "array",
          "description": "別名・異表記（検索用）。",
          "items": { "type": "string" }
        }
      }
    },

    "dynasty": {
      "type": "object",
      "description": "所属王朝。同一国号の別政権が複数あるため、(name, section) の複合キーで政権単位に一意となる。",
      "required": ["name", "category", "section"],
      "properties": {
        "name": {
          "type": "string",
          "description": "王朝名・国号（例:「秦」「宋」）。同名の別政権が存在するため単体では一意でない。"
        },
        "category": {
          "type": "string",
          "description": "政権の区分（例:「正統」「十六国」「正統（反乱・自称）」）。値は固定enumではない。"
        },
        "section": {
          "type": "string",
          "description": "調査ブロック名（例:「宋遼西夏金」「秦（始皇帝以降）」）。内部管理用の区分だが、同名王朝の識別キーとして機能する。時代区分ラベルとしてそのまま表示する用途は想定していない。"
        }
      }
    },

    "reign": {
      "type": "object",
      "description": "1回の在位期間。皇帝号を称していた期間のみを対象とする（即位前の王位期間等は含まない）。",
      "properties": {
        "startYear": {
          "type": ["integer", "null"],
          "description": "在位開始年（西暦・紀元前は負数。天文年方式ではなく歴史年方式で0年は存在しない）。"
        },
        "endYear": {
          "type": ["integer", "null"],
          "description": "在位終了年（西暦・紀元前は負数）。"
        },
        "startDate": {
          "type": ["string", "null"],
          "description": "在位開始日（ISO 8601 拡張形式。紀元前は4桁ゼロ埋めの負年で表す。例:「-0210-09-10」）。精度は datePrecision.start が示し、年精度なら「-0221」のように短い形になる。"
        },
        "endDate": {
          "type": ["string", "null"],
          "description": "在位終了日（形式は startDate と同じ）。"
        },
        "startDateRaw": {
          "type": ["string", "null"],
          "description": "原典の紀年表記そのまま（例:「始皇帝26年（前221年、天下統一・皇帝号採用）」）。"
        },
        "endDateRaw": {
          "type": ["string", "null"],
          "description": "原典の紀年表記そのまま（旧暦日付を含む）。"
        },
        "datePrecision": {
          "type": "object",
          "description": "startDate/endDate の精度。原典に日付記載がない場合は年・月止まりになる。",
          "properties": {
            "start": { "$ref": "#/$defs/datePrecisionValue" },
            "end": { "$ref": "#/$defs/datePrecisionValue" }
          }
        },
        "dynastyOrder": {
          "type": ["integer", "null"],
          "description": "王朝内の代数（初代=1）。"
        },
        "isRestoration": {
          "type": "boolean",
          "description": "この在位が復位（2回目以降の即位）かどうか。"
        },
        "duration": { "$ref": "#/$defs/duration" },
        "durationRaw": {
          "type": ["string", "null"],
          "description": "在位期間の元表記（例:「11年」）。"
        },
        "raw": {
          "type": ["string", "null"],
          "description": "在位期間の元表記（例:「紀元前221年 - 紀元前210年」）。"
        },
        "note": {
          "type": ["string", "null"],
          "description": "この在位期間についての注記（起点の取り方など）。"
        }
      }
    },

    "duration": {
      "type": "object",
      "description": "在位期間の長さ。approxDays は近似値であり、exactDays が null の場合は日単位の正確さを保証しない。",
      "properties": {
        "value": { "type": ["number", "null"], "description": "durationRaw に対応する数値。" },
        "unit": { "type": ["string", "null"], "description": "value の単位（例:「year」「day」）。" },
        "approxDays": {
          "type": ["integer", "null"],
          "description": "在位日数の近似値。年精度の日付から換算した推定を含むため、統計・比較用の値として扱うこと。"
        },
        "exactDays": {
          "type": ["integer", "null"],
          "description": "即位日・退位日が日精度で確定している場合の正確な在位日数。null なら未確定。"
        },
        "needsPreciseDays": {
          "type": "boolean",
          "description": "true の場合、日精度の確定調査が未了で approxDays が推定値であることを示す精度フラグ。"
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },

    "reignSummary": {
      "type": "object",
      "description": "複数在位を合算した代表値。ランキング・統計はこの値を用いる。",
      "properties": {
        "firstStartYear": { "type": ["integer", "null"], "description": "最初の在位の開始年。" },
        "lastEndYear": { "type": ["integer", "null"], "description": "最後の在位の終了年。" },
        "reignCount": { "type": "integer", "description": "在位回数（reigns 配列の長さ）。" },
        "totalReignDuration": {
          "type": "object",
          "description": "全在位期間の合算。",
          "properties": {
            "approxDays": {
              "type": ["integer", "null"],
              "description": "合算在位日数の近似値。isExact が false の場合は推定を含む。"
            },
            "exactDays": {
              "type": ["integer", "null"],
              "description": "全在位が日精度で確定している場合の正確な合算日数。"
            },
            "displayYears": {
              "type": ["number", "null"],
              "description": "表示用の在位年数。"
            },
            "isExact": {
              "type": "boolean",
              "description": "approxDays が正確値かどうかを示す精度フラグ。false なら近似値。"
            },
            "needsPreciseDays": {
              "type": "boolean",
              "description": "日精度の確定調査が未了であることを示す精度フラグ。"
            }
          }
        }
      }
    },

    "flags": {
      "type": "object",
      "properties": {
        "isFemale": { "type": "boolean", "description": "女性の皇帝か（武則天）。" },
        "selfProclaimed": {
          "type": "boolean",
          "description": "政権自体が自称・反乱由来か（人物個人の即位経路とは独立した軸。accessionRoute 参照）。"
        },
        "usedEmperorTitleFrom": {
          "type": ["integer", "null"],
          "description": "皇帝号を称し始めた年（西暦・紀元前は負数）。収録基準の根拠。"
        }
      }
    },

    "externalSources": {
      "type": "object",
      "description": "外部識別子。",
      "properties": {
        "wikidata": { "type": ["string", "null"], "pattern": "^Q[0-9]+$", "description": "Wikidata QID。365人全員に付与済み（2026-07-21）。" },
        "cbdb": { "type": ["string", "integer", "null"], "description": "CBDB ID（未紐付け）。" }
      }
    },

    "verification": {
      "type": "object",
      "description": "収録可否の検証結果。",
      "properties": {
        "emperorTitleConfirmed": {
          "type": "boolean",
          "description": "皇帝号を称した事実を原典で確認済みか。"
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "notes": { "type": ["string", "null"], "description": "検証の経緯・特記事項。" }
      }
    },

    "deathCause": {
      "type": "object",
      "description": "死因。単一カテゴリで、複合的な経緯は note に自然文で記す。定義は DEATH_CAUSE_SCHEMA.md。",
      "properties": {
        "category": {
          "type": "string",
          "description": "死因の分類（8種）。",
          "enum": ["病死", "暗殺", "処刑", "戦死", "自尽", "事故死", "不詳", "諸説あり"]
        },
        "note": {
          "type": ["string", "null"],
          "description": "死の経緯。原典の引用と判定理由を含む。"
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "source": { "$ref": "#/$defs/source" }
      }
    },

    "accessionRoute": {
      "type": "object",
      "description": "即位経路。4軸＋2補助（axes）が実体で、categoryId はそこから機械導出される表示用の確定値。複数回即位した人物は初回即位の経緯でラベルを付け、復位は reigns[].isRestoration が担う。定義は ADDITIONAL_SCHEMA.md 1節。",
      "properties": {
        "categoryId": {
          "type": "string",
          "description": "即位経路の表示用確定値（v3）。meta.catalogs.enums.accessionCategory の ID で、axes からの導出値と一致する（サイト側で優先順位ロジックを持たないための項目）。",
          "enum": [
            "hereditary", "enthroned", "self-established", "usurpation",
            "acclamation", "abdication-received", "succession-unspecified", "inner-abdication"
          ]
        },
        "category": {
          "type": "string",
          "description": "即位経路の表示ラベル。axes を持つレコードでは axes からの導出値（ADDITIONAL_SCHEMA.md 1節「導出ルール」）。旧 enum 9値は多軸化の移行完了まで併存する。",
          "enum": [
            "世襲", "擁立", "簒奪", "内禅", "継承（経緯記載なし）",
            "受禅（易姓）", "受禅（擁立）", "自立", "推戴",
            "受禅（易姓）", "受禅（擁立）", "自立", "推戴", "継承（経緯記載なし）"
          ]
        },
        "axes": {
          "type": "object",
          "description": "即位経路の多軸表現（2026-07-26 導入）。定義は ADDITIONAL_SCHEMA.md 1節「軸の定義」。enum・category との整合は validate_emperors.py の check_accession_axes が検査する。",
          "properties": {
            "throneSource": {
              "type": "string",
              "description": "軸1: 君主位の出所。",
              "enum": ["前代君主から継承", "他政権から受禅", "自立"]
            },
            "titleOrigin": {
              "type": "string",
              "description": "軸1b: 帝号の由来（バッジ表示）。",
              "enum": ["継承", "新称"]
            },
            "decidedBy": {
              "type": "array",
              "description": "軸2: 即位を決めた主体（実態）。複数値可。史料から決着不能は単独でのみ使用。",
              "minItems": 1,
              "items": { "type": "string", "enum": ["本人", "先帝", "第三者", "史料から決着不能"] }
            },
            "decidedByAgents": {
              "type": "array",
              "description": "軸2補助: 第三者の類型。decidedBy に第三者を含むときのみ非空。",
              "items": { "type": "string", "enum": ["臣下", "軍", "宦官", "外戚", "母后", "宗室"] }
            },
            "decidedByBasis": {
              "type": "string",
              "description": "軸2の判定が何で決着したか（記録必須）。",
              "enum": ["既存note", "原典再読"]
            },
            "predecessorFate": {
              "type": "string",
              "description": "軸3: 前帝の去就。",
              "enum": ["崩御", "横死", "生前譲位", "廃位・追放", "該当なし"]
            },
            "relationToPredecessor": {
              "type": "string",
              "description": "軸4: 先帝との血縁。kinship.json の succession エッジと同一語彙。",
              "enum": [
                "子", "弟", "兄", "父", "孫", "甥", "叔父", "伯父", "母", "従兄弟",
                "養子", "同族（遠縁）", "外戚（その他）", "無血縁", "その他", "該当なし"
              ]
            },
            "procedure": {
              "type": "string",
              "description": "補助1: 手続きの形式（建前）。",
              "enum": ["禅譲儀礼", "内禅", "通常の践祚", "儀礼なし・自称", "偽詔・矯詔"]
            }
          },
          "required": [
            "throneSource", "titleOrigin", "decidedBy", "decidedByBasis",
            "predecessorFate", "relationToPredecessor", "procedure"
          ],
          "additionalProperties": false
        },
        "note": {
          "type": ["string", "null"],
          "description": "即位の経緯。原典の引用と判定理由を含む。"
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "source": { "$ref": "#/$defs/source" }
      }
    },

    "ages": {
      "type": "object",
      "description": "即位時年齢・没年齢。中国史の慣行に合わせ全て数え年で統一する（生年を1歳とする）。原典に記載がなく確定できない場合は null。",
      "properties": {
        "birthDate": {
          "type": ["string", "null"],
          "description": "生年月日（ISO 8601 拡張形式。紀元前は4桁ゼロ埋めの負年）。精度は birthDatePrecision が示す。"
        },
        "birthDatePrecision": { "$ref": "#/$defs/datePrecisionAnnotated" },
        "deathDate": {
          "type": ["string", "null"],
          "description": "没年月日（形式は birthDate と同じ）。"
        },
        "deathDatePrecision": { "$ref": "#/$defs/datePrecisionAnnotated" },
        "accessionAge": {
          "type": ["integer", "null"],
          "description": "皇帝即位時の数え年。皇帝号採用時点で数える（先行する王位即位時ではない）。調査済みだが原典から確定できない場合は null。"
        },
        "deathAge": {
          "type": ["integer", "null"],
          "description": "没時の数え年。調査済みだが確定できない場合は null。"
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "note": { "type": ["string", "null"], "description": "算出根拠・原典の年齢記載。" }
      }
    },

    "datedEventCount": {
      "type": "object",
      "description": "回数系指標のうち、単一日付のイベントを列挙するもの（改元・大赦・立后・皇太子廃立）。",
      "properties": {
        "count": {
          "type": "integer",
          "description": "回数。原則 events 配列の長さと一致する（一致しない場合の理由は note に記す）。",
          "minimum": 0
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": ["string", "null"], "description": "発生日（ISO 8601 拡張形式）。" },
              "datePrecision": { "$ref": "#/$defs/datePrecisionAnnotated" },
              "note": { "type": ["string", "null"], "description": "内容・原典の記述。" },
              "source": { "$ref": "#/$defs/source" }
            }
          }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "note": {
          "type": ["string", "null"],
          "description": "指標レベルの注記。典拠とした書名・巻や、数え方の判断を含む。"
        }
      }
    },

    "capitalRelocationCountObject": {
      "type": "object",
      "description": "遷都回数。数え方の基準は ADDITIONAL_SCHEMA.md 6節。",
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": { "type": ["string", "null"] },
              "datePrecision": { "$ref": "#/$defs/datePrecisionAnnotated" },
              "from": { "type": ["string", "null"], "description": "遷都元の都城名。" },
              "to": { "type": ["string", "null"], "description": "遷都先の都城名。" },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "note": { "type": ["string", "null"] }
      }
    },

    "campaignCountObject": {
      "type": "object",
      "description": "親征回数。期間を持つイベントのため startDate/endDate の対で記録する。",
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startDate": { "type": ["string", "null"] },
              "endDate": { "type": ["string", "null"] },
              "datePrecision": {
                "type": ["object", "string", "null"],
                "description": "日付精度。start/end の対、または単一値。"
              },
              "target": { "type": ["string", "null"], "description": "遠征対象（勢力名・地域名）。" },
              "outcome": { "type": ["string", "null"], "description": "結果。" },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "note": { "type": ["string", "null"] }
      }
    },

    "rebellionCountObject": {
      "type": "object",
      "description": "反乱鎮圧回数・被反乱回数。期間を持つイベントとして記録する。",
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startDate": { "type": ["string", "null"] },
              "endDate": { "type": ["string", "null"] },
              "datePrecision": {
                "type": ["object", "string", "null"],
                "description": "日付精度。start/end の対、または単一値。"
              },
              "name": { "type": ["string", "null"], "description": "反乱の名称。" },
              "leader": { "type": ["string", "null"], "description": "反乱の首謀者。" },
              "outcome": { "type": ["string", "null"], "description": "結果。" },
              "note": { "type": ["string", "null"] }
            }
          }
        },
        "confidence": { "$ref": "#/$defs/confidence" },
        "note": { "type": ["string", "null"] }
      }
    },

    "source": {
      "type": ["object", "null"],
      "description": "判定根拠の出典。原則として正史の巻名（本紀・列伝）を指す。",
      "properties": {
        "page": {
          "type": "string",
          "description": "出典の書名・巻名（例:「史記・秦始皇本紀」）。"
        },
        "lang": {
          "type": ["string", "null"],
          "description": "出典の言語（例:「zh-classical」＝漢文原典、「ja」「zh」）。複数併記の自由記述もある。"
        },
        "note": {
          "type": ["string", "null"],
          "description": "出典に関する補足（該当箇所・引用原文など）。"
        },
        "quote": {
          "type": ["string", "null"],
          "description": "日付根拠になった正史原文の直接引用（即位／退位を「／」で区切る）。reigns[].duration.source で使用（task.md 3-1 フェーズBで新設）。"
        },
        "conversion": {
          "type": ["string", "null"],
          "description": "旧暦（干支日）→西暦の換算典拠と既存日付との照合結果。正史に日次記述がない場合はその旨を記す。reigns[].duration.source で使用（task.md 3-1 フェーズBで新設）。"
        }
      }
    },

    "datePrecisionValue": {
      "type": ["string", "null"],
      "description": "日付の精度。対応する日付文字列がどこまで確定しているかを示す。reigns[].datePrecision はこの3値に統一されている。",
      "enum": ["day", "month", "year", null]
    },

    "datePrecisionAnnotated": {
      "type": ["string", "null"],
      "description": "日付の精度（注記つき自由記述）。ages と events[] の精度フィールドは、基本値（day / month / year）に加えて、判定できない場合の値（unknown / none / conflicting など）や、換算状況を括弧で補記した形（例:「day（干支紀日、西暦換算は概算）」「day(lunar, unconverted)」）を取る。これは旧暦・干支表記の西暦換算が未実施であることを失わずに記録するための運用で、機械処理する場合は先頭の基本値トークンを取り出すこと。reigns[].datePrecision（3値に統一済み）とは扱いが異なる。"
    },

    "confidence": {
      "description": "判定の確信度。情報源間で不一致が残る場合は medium とし note に経緯を記す。空文字列は確信度が未設定であることを示す（回数系の4件に存在する既知の欠損）。",
      "anyOf": [
        { "enum": ["high", "medium", "low"] },
        { "const": "", "description": "未設定（既知の欠損）。" },
        { "type": "null" }
      ]
    }
  }
}
