# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# python
__pycache__/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# external reference corpus (large, not part of this repo's dataset)
/china-history
/daizhigev20

# generated per-emperor source text cache (regenerate with scripts/build_corpus_cache.py)
/_corpus_cache

# normalized corpus text cache (verify_quotes.py rebuilds it on demand; ~800MB)
/_norm_cache

# claude.ai/design sync (staged converter scripts, build output, machine state)
site/.ds-sync/
site/ds-bundle/

# 確認用スクリーンショット（site/tools/capture-site.mjs の出力・撮り直せるので履歴に入れない）
site/tools/shots/


# Claude Code フックの発火ログ（ローカル計測用・docs/process/RULES.yml の「測定」節）
.claude/hook-log.jsonl
review/

# Gemini API キー（絶対にコミットしない）
.gemini/

# 系譜図レイアウトのスパイク（elkjs は --no-save で入れる・生成物は再現できる）
site/tools/kinship-layout-spike/node_modules/
site/tools/kinship-layout-spike/graph-*.json
site/tools/kinship-layout-spike/groups-*.json
site/tools/kinship-layout-spike/pos-*.json
