{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep|Read",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}/.claude/hooks/guard.py\"; [ -f \"$g\" ] || exit 0; exec python3 \"$g\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "s=\"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}/.claude/session-start-branch.sh\"; [ -f \"$s\" ] && bash \"$s\" 2>/dev/null; true",
            "statusMessage": "作業ブランチを確認しています",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
